# Copy to .env.local and fill in. Never commit real values.
#
# Google Cloud Console → APIs & Services → Credentials →
#   Create OAuth client ID → Web application
#
# Add your dev origin to "Authorized JavaScript origins", e.g.
#   http://localhost:5173
# No redirect URI is needed: the GSI token flow uses a popup.
#
# Enable "YouTube Data API v3" under APIs & Services → Library.
#
# On the OAuth consent screen, add the scopes requested in
# src/api/google/config.ts:
#   .../auth/userinfo.profile
#   .../auth/userinfo.email
#   .../auth/youtube          <- restricted; needs verification for production
#
# Anything prefixed with VITE_ is readable by anyone using the site.
# The client id is meant to be public; the client SECRET is not — keep it out.
VITE_GOOGLE_CLIENT_ID=
